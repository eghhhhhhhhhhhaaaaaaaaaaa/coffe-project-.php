_submitter":null,"link":null,"story_cta":null,"like_count":97,"organic_tracking_token":"","invited_coauthor_producers":[],"carousel_media_count":null,"all_previous_submitters":null,"coauthor_producers":[],"sponsor_tags":null,"follow_hashtag_info":null,"can_viewer_reshare":true,"ig_media_sharing_disabled":false,"like_and_view_counts_disabled":false,"comments_disabled":null,"feed_demotion_control":null,"feed_recs_demotion_control":null,"ai_label_info":null,"ai_interactive_embodiment_attachment_style_info":null,"is_paid_partnership":false,"affiliate_info":null,"clips_attribution_info":null,"media_attributions_data":[],"clips_metadata":{"music_info":null,"original_sound_info":{"audio_asset_id":"25941405935557725","original_audio_title":"Original audio","ig_artist":{"username":"ssbunsoed_official","id":"76647089872","profile_pic_url":"https:\/\/instagram.fcgk6-2.fna.fbcdn.net\/v\/t51.82787-19\/534329613_17844578607553873_3497183249082083272_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=instagram.fcgk6-2.fna.fbcdn.net&_nc_cat=101&_nc_oc=Q6cZ2gGbYpaPwyYw77AchXtcXtS70f9fW_OpoQyGenHPo-Qml1eIhIK5ynuTGSlaEUOW7j0&_nc_ohc=4GJLU6cNeoAQ7kNvwHP6gUG&_nc_gid=t0S-86IIcQdNBV80eVPpFg&edm=APs17CUBAAAA&ccb=7-5&oh=00_AQB1oRMaPIvXmVT66Mo75nKX9lQKnCadnafzMkaWbN6SHQ&oe=6A568A63&_nc_sid=10d13b"},"is_explicit":false,"should_mute_audio":false,"consumption_info":{"should_mute_audio_reason":"","is_trending_in_clips":false,"should_mute_audio_reason_type":null},"audio_filter_infos":null},"originality_info":null,"is_shared_to_fb":false},"location":null,"wearable_attribution_info":null,"caption":{"pk":"18048749531577569","text":"Di balik senyum mereka, ada kerja keras yang tidak semua orang lihat. Di balik latihan tambahan ini, ada mimpi yang sedang diperjuangkan.\n\nTerus semangat anak-anak SSB UNSOED. Langkah kecil hari ini akan membawa kalian menuju prestasi di masa depan. \ud83d\udc9b\u26bd\n\n\u201cBerlatih dengan disiplin, bermain dengan hati, dan tumbuh menjadi pribadi yang hebat.\u201d\n\n#SSBUNSOED #LatihanTambahan #MentalJuara #SepakBolaUsiaDini","has_translation":null},"caption_is_edited":false,"headline":null,"view_count":null,"top_likers":["mm_florist_baturaden"],"facepile_top_likers":[{"profile_pic_url":"https:\/\/instagram.fcgk6-3.fna.fbcdn.net\/v\/t51.82787-19\/626512603_18314390992252869_3660921948109667072_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43ODAuYzIifQ&_nc_ht=instagram.fcgk6-3.fna.fbcdn.net&_nc_cat=109&_nc_oc=Q6cZ2gGbYpaPwyYw77AchXtcXtS70f9fW_OpoQyGenHPo-Qml1eIhIK5ynuTGSlaEUOW7j0&_nc_ohc=Eva8ZRkkDGAQ7kNvwGD1dlq&_nc_gid=t0S-86IIcQdNBV80eVPpFg&edm=APs17CUBAAAA&ccb=7-5&oh=00_AQCoTsGF2HNAtLWlPYpWEp4YTdb6vBd0jVTYyhAAZTi-NQ&oe=6A56AE33&_nc_sid=10d13b","id":"7530196868"}],"hidden_likes_string_variant":-1,"fb_like_count":null,"crosspost_metadata":{"is_feedback_aggregated":null,"is_feed_feedback_aggregated":null},"social_context":[{"social_context_type":"liked_by","social_context_users_count":97,"social_context_facepile_users":[{"profile_pic_url":"https:\/\/instagram.fcgk6-3.fna.fbcdn.net\/v\/t51.82787-19\/626512603_18314390992252869_3660921948109667072_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby43ODAuYzIifQ&_nc_ht=instagram.fcgk6-3.fna.fbcdn.net&_nc_cat=109&_nc_oc=Q6cZ2gGbYpaPwyYw77AchXtcXtS70f9fW_OpoQyGenHPo-Qml1eIhIK5ynuTGSlaEUOW7j0&_nc_ohc=Eva8ZRkkDGAQ7kNvwGD1dlq&_nc_gid=t0S-86IIcQdNBV80eVPpFg&edm=APs17CUBAAAA&ccb=7-5&oh=00_AQCoTsGF2HNAtLWlPYpWEp4YTdb6vBd0jVTYyhAAZTi-NQ&oe=6A56AE33&_nc_sid=10d13b","userID":"7530196868","username":"mm_florist_baturaden","id":"7530196868"}],"__typename":"XDTSocialContextInfo"}],"comment_count":0,"can_reshare":null,"enable_media_notes_production":true,"media_repost_count":9,"saved_collection_ids":null,"has_viewer_saved":null,"sharing_friction_info":{"should_have_sharing_friction":false,"bloks_app_url":null},"boosted_status":null,"boost_unavailable_identifier":null,"boost_unavailab