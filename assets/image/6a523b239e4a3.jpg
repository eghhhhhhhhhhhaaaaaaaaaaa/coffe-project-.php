"can_viewer_reshare":true,"ig_media_sharing_disabled":false,"like_and_view_counts_disabled":false,"comments_disabled":null,"feed_demotion_control":null,"feed_recs_demotion_control":null,"ai_label_info":null,"ai_interactive_embodiment_attachment_style_info":null,"is_paid_partnership":false,"affiliate_info":null,"clips_attribution_info":null,"media_attributions_data":[],"clips_metadata":null,"location":null,"wearable_attribution_info":null,"caption":{"pk":"18273726544288718","text":"PERSIBAS BANYUMAS SECARA RESMI MEMBUKA SELEKSI TERBUKA GUNA PERSIAPAN TURNAMEN PIALA SOERATIN CUP U-17 2026 DI BULAN AGUSTUS MENDATANG\n\nKETUM PERSIBAS, MENYAMPAIKAN SEBUAH PESAN KEPADA PELATIH DALAM PEMILIHAN SELEKSI PEMAIN DENGAN JUJUR TIDAK ADA \"PEMAIN TITIPAN\"\n\nDAN JUGA MENYAMPAIKAN KEPADA \"CALON PEMAIN\" DALAM KEIKUTSERTAAN PIALA SOERATIN CUP U-17 NANTI TIDAK HANYA SEBAGAI PELENGKAP SAJA TAPI BISA MEMBERIKAN YANG TERBAIK UNTUK KABUPATEN BANYUMAS\n\nWAKTUNYA KALIAN MEMBUKTIKAN DIRI!! \n\nDoc. \u0040persibasofficial \n\n____\n\nPersibas Banyumas Gelar Seleksi Pemain Junior Untuk Persiapan Soeratin Cup U-17 2026.\n\nPersibas Banyumas resmi menggelar seleksi pemain junior sebagai langkah awal persiapan menghadapi ajang Soeratin Cup U-17, yang akan berlangsung pada bulan Agustus 2026.\n\nKegiatan seleksi ini dihadiri langsung oleh Ketua Umum Persibas, Bapak Trisno Sudarso, bersama tim pelatih dan pembina.\n\nDalam kesempatan tersebut, Ketua Umum Persibas menyampaikan, \"Seleksi ini kita lakukan jauh-jauh hari agar punya waktu cukup untuk membentuk tim yang solid. \nTarget kita di Soeratin Cup nanti bukan hanya partisipasi saja, tapi bisa memberikan hasil terbaik untuk Banyumas. \n\nSaya meminta pelatih untuk jujur dalam memilih pemain, mencari pemain yang punya kualitas, disiplin, dan semangat juang tinggi.\"\n\nSeleksi akan berlangsung secara terbuka dan bertahap. \n\nPersibas berharap bisa menemukan bibit-bibit muda potensial dari Banyumas dan sekitarnya untuk memperkuat tim ke depan.\n\n\ud83d\udcf7 : \u0040persibasofficial\n\n#persibas #ultrasschoolpwt #ultrasschoolpurwokerto #banyumas #purwokerto","has_translation":null},"caption_is_edited":false,"headline":null,"view_count":null,"top_likers":["fzznnn9"],"facepile_top_likers":[{"profile_pic_url":"https:\/\/instagram.fcgk6-3.fna.fbcdn.net\/v\/t51.82787-19\/515603654_18049820615614373_2824432189395694056_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDc5LmMyIn0&_nc_ht=instagram.fcgk6-3.fna.fbcdn.net&_nc_cat=105&_nc_oc=Q6cZ2gGbYpaPwyYw77AchXtcXtS70f9fW_OpoQyGenHPo-Qml1eIhIK5ynuTGSlaEUOW7j0&_nc_ohc=uqAzELvQ_EYQ7kNvwExMG03&_nc_gid=t0S-86IIcQdNBV80eVPpFg&edm=APs17CUBAAAA&ccb=7-5&oh=00_AQBsFezAPHtleRHTzDGT3SfW9e9q9vlj4FITXixIiVic6g&oe=6A56AEB5&_nc_sid=10d13b","id":"48296870372"},{"profile_pic_url":"https:\/\/instagram.fcgk6-2.fna.fbcdn.net\/v\/t51.82787-19\/637117270_17950448352088918_6617960729278304065_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=instagram.fcgk6-2.fna.fbcdn.net&_nc_cat=110&_nc_oc=Q6cZ2gGbYpaPwyYw77AchXtcXtS70f9fW_OpoQyGenHPo-Qml1eIhIK5ynuTGSlaEUOW7j0&_nc_ohc=_Z4vngPN2g4Q7kNvwFqPKtE&_nc_gid=t0S-86IIcQdNBV80eVPpFg&edm=APs17CUBAAAA&ccb=7-5&oh=00_AQC1huQSw9vz3dXpstuB755DqjVm442aBznIIBsFvgwVvQ&oe=6A56A90E&_nc_sid=10d13b","id":"62722672917"}],"hidden_likes_string_variant":-1,"fb_like_count":null,"crosspost_metadata":{"is_feedback_aggregated":null,"is_feed_feedback_aggregated":null},"social_context":[{"social_context_type":"liked_by","social_context_users_count":623,"social_context_facepile_users":[{"profile_pic_url":"https:\/\/instagram.fcgk6-3.fna.fbcdn.net\/v\/t51.82787-19\/515603654_18049820615614373_2824432189395694056_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDc5LmMyIn0&_nc_ht=instagram.fcgk6-3.fna.fbcdn.net&_nc_cat=105&_nc_oc=Q6cZ2gGbYpaPwyYw77AchXtcXtS70f9fW_OpoQyGenHPo-Qml1eIhIK5ynuTGSlaEUOW7j0&_nc_ohc=uqAzELvQ_EYQ7kNvwExMG03&_nc_gid=t0S-86II